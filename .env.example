# --- Client-side (bundled into the browser build; MUST be prefixed VITE_) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Server-side only, used by /api/*.js serverless functions. ---
# --- NEVER prefix these with VITE_ or they'd ship in the JS bundle. ---
GMAIL_USER=your-app-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Supabase "service_role" key (Project Settings -> API). Bypasses RLS entirely,
# so it's used only by /api routes, never by the browser bundle. Treat it like
# a database root password.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# A random secret shared between this app and the GitHub Actions workflow in
# .github/workflows/user-request-sync.yml, so /api/github-user-request can
# tell "a real request from our own Action" apart from anyone else on the
# internet POSTing to that URL. Generate one with e.g. `openssl rand -hex 32`,
# then set the SAME value here and as a GitHub repo secret of the same name.
INTERNAL_API_SECRET=a-long-random-string
