# --- Client-side (bundled into the browser build; MUST be prefixed VITE_) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Server-side only, used by /api/*.js serverless functions. ---
# --- NEVER prefix these with VITE_ or they'd ship in the JS bundle. ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
